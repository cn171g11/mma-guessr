# MmaGuessr backend - Go + SQLite 配置示例
# 复制为 .env 或直接导出为环境变量使用。

# 服务端口
PORT=3000

# 运行环境（development | production）
# production 下缺失/默认密钥会被拒绝启动（见 requiredSecret 校验）
NODE_ENV=development

# SQLite 数据库文件路径（单文件，自动建表）
SQLITE_PATH=mma_guessr.db

# Go 运行时内存调优（跨平台，可选）：
# GOGC     GC 触发百分比（默认 100；调低如 50 让内存更快回落，调高减少 GC 开销；off 关闭自动 GC）
# GOMEMLIMIT  软堆上限（字节），如 1073741824 = 1GiB，防止突发流量撑爆内存
# 留空即用 Go 运行时默认值；100k 压力请求后堆内存不回落是 GOGC=100 的正常表现。
GOGC=100
# GOMEMLIMIT=536870912

# Mapillary 图片代理密钥（仅服务端持有，勿提交到仓库）
MAPILLARY_TOKEN=

# auth: JWT 签名密钥（生产环境必须设置为至少 32 字节的强随机值, 不要使用默认值!!!）
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef
# 验证码哈希密钥（HMAC）, 与令牌密钥隔离; 生产环境必须设置强随机值
VERIFY_CODE_SECRET=dev-verify-code-secret-not-for-production-0123456789

# API 请求签名密钥（与前端 api.js 保持一致, 生产环境必须为强随机值）
API_SIGNING_SECRET=dev-signing-secret-change-me

# 邮箱验证码发送(SMTP), 未配置时开发模式会把验证码打印到日志, 便于联调
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# CORS 来源白名单（逗号分隔，例如 https://your-game.com,https://dev.mma-guessr.com）
# 为空时仅允许 localhost/127.0.0.1（开发默认）；生产部署必须配置为前端实际域名
CORS_ALLOWED_ORIGINS=

# refresh cookie 的 SameSite 属性（lax | strict | none）
COOKIE_SAME_SITE=lax

# Prometheus metrics 端点令牌；留空则 /api/metrics 拒绝访问（生产推荐）
METRICS_TOKEN=

# 反向代理跳数：仅当部署在可信反代（nginx/caddy 等）之后时显式设置（如 1），
# 启用后按真实客户端 IP 做限频；未设置则按直连处理，防止伪造 XFF 头绕过限频
TRUST_PROXY=0

# 赞助管理令牌：写 /api/sponsors（新增/删除）需携带 Authorization: Bearer <此值>
# 留空时赞助写端点不可用；建议生产环境设置强随机值
SPONSOR_ADMIN_TOKEN=

# 第三方登录（Google OAuth，可选）：三者齐备才启用 /api/oauth
# 回调地址须与 Google Cloud Console 中配置的 Redirect URI 完全一致（HTTPS；本地开发可用 http://localhost:3000）
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# OAuth state 令牌签名密钥（配置了 Google OAuth 后必填；生产必须为强随机值）
OAUTH_STATE_SECRET=dev-oauth-state-secret-not-for-production-0123456789
