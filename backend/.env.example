# 实际使用的时候把文件名.env.example 改为 .env
# 服务端口
PORT=3000

# 日志级别（debug | info | warn | error）
LOG_LEVEL=info

# PostgreSQL（与 docker-compose.yml 保持一致）
DATABASE_URL=postgres://mma:mma@localhost:5432/mma_guessr

# Redis
REDIS_URL=redis://localhost:6379

# Mapillary 图片代理密钥（仅服务端持有，勿提交到仓库）
MAPILLARY_TOKEN=

# auth
# JWT signature key (生产环境必须设置为强随机值, 不要使用默认值!!!)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# 邮箱验证码发送(SMTP), 未配置时开发模式会把验证码打印到日志, 便于联调
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
