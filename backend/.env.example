# 实际使用的时候把文件名.env.example 改为 .env
# 服务端口
PORT=3000

# 日志级别（debug | info | warn | error）
LOG_LEVEL=info

# PostgreSQL（与 docker-compose.yml 保持一致）
# 生产环境必须设置强随机密码，且不向公网暴露端口（compose 默认已仅绑定 127.0.0.1）
DATABASE_URL=postgres://mma:mma@localhost:5432/mma_guessr
POSTGRES_PASSWORD=mma

# Redis（compose 已开启 requirepass，连接串需带密码）
# 生产环境必须设置强随机密码，且不向公网暴露端口
REDIS_URL=redis://:mma@localhost:6379
REDIS_PASSWORD=mma

# Mapillary 图片代理密钥（仅服务端持有，勿提交到仓库）
MAPILLARY_TOKEN=

# auth
# JWT signature key (生产环境必须设置为强随机值, 不要使用默认值!!!)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# 邮箱验证码发送(SMTP), 未配置时开发模式会把验证码打印到日志, 便于联调
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# CORS 与 Socket.IO 来源白名单（逗号分隔，例如 https://your-game.com,https://dev.mma-guessr.com）
# 为空时仅允许 localhost/127.0.0.1（开发默认）；生产部署必须配置为前端实际域名，否则浏览器请求会被拒绝
CORS_ALLOWED_ORIGINS=

# 反向代理跳数：仅当部署在可信反代（nginx/caddy 等）之后时显式设置（如 1），
# 启用后按真实客户端计算 req.ip 做限频；未设置则按直连处理，防止伪造 XFF 头绕过限频
#TRUST_PROXY=1

# 刷新令牌 Cookie 的 SameSite 策略（strict | lax | none）。
# 前端与 API 同站（同一顶级域下的不同子域）保持默认 lax 即可；跨站（不同域名）且使用 HTTPS 时设为 none
COOKIE_SAME_SITE=lax

# 请求签名密钥（HMAC-SHA256）：设置后所有 /api 请求（除探活/指标/图源代理）必须携带
# 时间戳+nonce 签名，服务端校验时间窗并在 Redis 记录 nonce 防重放。
# 前端为静态站点，该密钥最终会出现在公开 JS 中，仅提供防篡改/防重放，不做认证。
# 开发默认留空（关闭签名校验）；启用时须与 frontend/src/js/config.js 的 API_SIGNING_SECRET 保持一致
#API_SIGNING_SECRET=dev-signing-secret-change-me
