{
    "name": "mma-guessr-backend",
    "version": "0.1.0",
    "private": true,
    "description": "MmaGuessr 后端服务: Express + TypeScript + PostgreSQL + Redis",
    "license": "Apache-2.0",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "db:up": "docker compose up -d",
        "db:down": "docker compose down",
        "db:migrate": "tsx src/db/migrate.ts",
        "db:seed": "node scripts/seed-locations.mjs",
        "lb:rebuild": "tsx src/cli/rebuild-leaderboards.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "script:check": "node scripts/check.mjs",
        "script:build": "node scripts/build.mjs",
        "script:test": "node scripts/test.mjs",
        "script:clean": "node scripts/clean.mjs",
        "script:debug": "node scripts/debug.mjs",
        "script:deploy": "node scripts/deploy.mjs"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^5.0.1",
        "ioredis": "^5.4.1",
        "jsonwebtoken": "^9.0.3",
        "nodemailer": "^9.0.4",
        "pg": "^8.14.1",
        "socket.io": "^4.8.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.10.5",
        "@types/nodemailer": "^8.0.1",
        "@types/pg": "^8.11.10",
        "@types/supertest": "^7.2.1",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^9.1.0",
        "prettier": "^3.3.3",
        "socket.io-client": "^4.8.3",
        "supertest": "^7.2.2",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.18.2",
        "vitest": "^4.1.10"
    }
}
